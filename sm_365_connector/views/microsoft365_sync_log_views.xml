<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_365_sync_log_list" model="ir.ui.view">
        <field name="name">sm.365.sync.log.list</field>
        <field name="model">sm.365.sync.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" string="Date"/>
                <field name="connection_id"/>
                <field name="sync_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"/>
                <field name="details"/>
            </tree>
        </field>
    </record>

    <record id="view_365_sync_log_form" model="ir.ui.view">
        <field name="name">sm.365.sync.log.form</field>
        <field name="model">sm.365.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="sync_type"/>
                            <field name="status"/>
                            <field name="create_date" string="Date"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_365_sync_log" model="ir.actions.act_window">
        <field name="name">Sync History</field>
        <field name="res_model">sm.365.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
