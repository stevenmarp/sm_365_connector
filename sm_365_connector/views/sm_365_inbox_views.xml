<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Unified Outlook Inbox: mail.message filtered to Microsoft-synced emails -->
    <record id="view_365_inbox_list" model="ir.ui.view">
        <field name="name">sm.365.inbox.list</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
            <tree create="false" string="Outlook Inbox">
                <field name="microsoft365_is_read" widget="boolean_toggle" string="Read"/>
                <field name="date"/>
                <field name="email_from"/>
                <field name="subject"/>
                <field name="microsoft365_has_attachments" widget="boolean_toggle" string="Attach" readonly="1"/>
                <field name="microsoft365_conversation_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_365_inbox_form" model="ir.ui.view">
        <field name="name">sm.365.inbox.form</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
            <form create="false" string="Outlook Email">
                <sheet>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="email_from"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="microsoft365_is_read"/>
                            <field name="microsoft365_has_attachments"/>
                            <field name="microsoft365_conversation_id"/>
                            <field name="microsoft365_id"/>
                        </group>
                    </group>
                    <separator string="Body"/>
                    <field name="body" widget="html" readonly="1"/>
                    <separator string="Attachments"/>
                    <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_365_inbox_search" model="ir.ui.view">
        <field name="name">sm.365.inbox.search</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="email_from"/>
                <field name="body"/>
                <filter name="unread" string="Unread"
                        domain="[('microsoft365_is_read', '=', False)]"/>
                <filter name="attachments" string="Has Attachments"
                        domain="[('microsoft365_has_attachments', '=', True)]"/>
                <separator/>
                <filter name="group_sender" string="Sender" context="{'group_by': 'email_from'}"/>
                <filter name="group_thread" string="Conversation"
                        context="{'group_by': 'microsoft365_conversation_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_365_inbox" model="ir.actions.act_window">
        <field name="name">Outlook Inbox</field>
        <field name="res_model">mail.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('microsoft365_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_365_inbox_search"/>
        <field name="context">{'search_default_unread': 0}</field>
    </record>

</odoo>
