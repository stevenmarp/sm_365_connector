<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Connection Kanban Dashboard -->
    <record id="view_365_connection_kanban" model="ir.ui.view">
        <field name="name">sm.365.connection.kanban</field>
        <field name="model">sm.365.connection</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="true">
                <field name="name"/>
                <field name="state"/>
                <field name="outlook_user_email"/>
                <field name="last_sync"/>
                <field name="sync_log_error_count"/>
                <field name="contact_synced_count"/>
                <field name="event_synced_count"/>
                <field name="email_synced_count"/>
                <field name="task_synced_count"/>
                <field name="webhooks_enabled"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card o_kanban_record">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="outlook_user_email"/>
                                    </div>
                                </div>
                                <div class="float-end">
                                    <field name="state" widget="badge"
                                           decoration-success="state in ('outlook_connected','fully_connected')"
                                           decoration-danger="state == 'error'"/>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <div class="col-6">
                                        <a type="object" name="action_sync_contacts" role="button">
                                            <span class="fa fa-users" title="Contacts" role="img" aria-label="Contacts"/>
                                            <field name="contact_synced_count"/> Contacts
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a type="object" name="action_sync_calendar" role="button">
                                            <span class="fa fa-calendar" title="Events" role="img" aria-label="Events"/>
                                            <field name="event_synced_count"/> Events
                                        </a>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <a type="object" name="action_import_emails" role="button">
                                            <span class="fa fa-envelope" title="Emails" role="img" aria-label="Emails"/>
                                            <field name="email_synced_count"/> Emails
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a type="object" name="action_sync_todo_tasks" role="button">
                                            <span class="fa fa-check-square-o" title="Tasks" role="img" aria-label="Tasks"/>
                                            <field name="task_synced_count"/> Tasks
                                        </a>
                                    </div>
                                </div>
                                <div class="row mt8" t-if="record.sync_log_error_count.raw_value">
                                    <div class="col-12">
                                        <a type="object" name="action_retry_failed" role="button"
                                           class="btn btn-sm btn-warning">
                                            <span class="fa fa-refresh" title="Retry" role="img" aria-label="Retry"/>
                                            Retry <field name="sync_log_error_count"/> failed
                                        </a>
                                    </div>
                                </div>
                                <div class="row mt8">
                                    <div class="col-6 text-muted">
                                        Last sync: <field name="last_sync"/>
                                    </div>
                                    <div class="col-6 text-end">
                                        <span t-if="record.webhooks_enabled.raw_value"
                                              class="badge text-bg-info">
                                            <i class="fa fa-bolt"/> Real-time
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
