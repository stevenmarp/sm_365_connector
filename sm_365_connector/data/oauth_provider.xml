<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Microsoft Azure AD OAuth2 provider for SSO login -->
        <record id="provider_microsoft_365" model="auth.oauth.provider">
            <field name="name">Microsoft 365</field>
            <field name="enabled" eval="False"/>
            <field name="auth_endpoint">https://login.microsoftonline.com/common/oauth2/v2.0/authorize</field>
            <field name="validation_endpoint">https://graph.microsoft.com/oidc/userinfo</field>
            <field name="scope">openid profile email User.Read</field>
            <field name="data_endpoint"></field>
            <field name="css_class">fa fa-windows</field>
            <field name="body">Sign in with Microsoft 365</field>
            <field name="sequence">10</field>
        </record>

    </data>
</odoo>
