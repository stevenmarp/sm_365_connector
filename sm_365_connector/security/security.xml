<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Security Groups -->
    <record id="group_365_user" model="res.groups">
        <field name="name">Microsoft 365 User</field>
        <field name="comment">Can sync data and send emails via Microsoft 365.</field>
    </record>

    <record id="group_365_manager" model="res.groups">
        <field name="name">Microsoft 365 Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_365_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access: configure connections, manage settings, view logs.</field>
    </record>

</odoo>
